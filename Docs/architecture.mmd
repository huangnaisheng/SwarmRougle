    Engine[Unreal Engine 5.4] --> Runtime[SwarmRogue Runtime]
    Runtime --> Character[SRCharacter]
    Runtime --> PlayerState[SRPlayerState]
    PlayerState --> ASC[AbilitySystemComponent]
    PlayerState --> Attributes[SRAttributeSet]
